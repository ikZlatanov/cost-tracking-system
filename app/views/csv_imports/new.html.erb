<div class="min-h-screen flex flex-col bg-slate-50">
  <%= render 'shared/header' %>
  
  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full bg-white p-8 rounded-xl shadow-lg border border-slate-200">
      
      <div class="mb-8 border-b border-slate-200 pb-4">
        <h2 class="text-3xl font-extrabold text-slate-900">Import CSV File</h2>
        <p class="mt-2 text-sm text-slate-500">Upload a CSV file to bulk import expenses. The original file is retained for audit purposes.</p>
      </div>

      <%= form_with url: csv_imports_path, local: true, multipart: true, class: "space-y-6", data: { turbo: false } do |f| %>
        
        <% if flash.now[:alert] %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <h3 class="text-sm font-medium text-red-800"><%= flash.now[:alert] %></h3>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-900 mb-1">Upload File *</label>
            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 border-dashed rounded-lg hover:border-[#003e8d] transition-colors bg-slate-50 focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-[#003e8d]">
              <div class="space-y-1 text-center">
                <svg class="mx-auto h-12 w-12 text-slate-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="flex text-sm text-slate-600 justify-center mt-2">
                  <label for="file-upload" class="relative cursor-pointer bg-white rounded-md font-medium text-[#003e8d] hover:text-[#003e8d]/80 focus-within:outline-none">
                    
                    <span id="file-name-display">Upload a file</span>
                    
                    <%= f.file_field :file, id: "file-upload", class: "sr-only", accept: ".csv", required: true %>
                  </label>
                  <p class="pl-1">or drag and drop</p>
                </div>
                <p class="text-xs text-slate-500">CSV up to 10MB</p>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-4 flex justify-end space-x-3 border-t border-slate-200 mt-6">
          <% cancel_path = case current_user.role
                           when 'admin' then admin_dashboard_path
                           when 'project_manager' then pm_dashboard_path
                           when 'developer' then developer_dashboard_path
                           else root_path
                           end %>

          <%= link_to "Cancel", cancel_path, class: "px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003e8d]" %>
          <%= f.submit "Upload CSV", class: "px-4 py-2 text-sm font-medium text-white bg-[#003e8d] rounded-lg hover:bg-[#003e8d]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003e8d] cursor-pointer" %>
        </div>
  
      <% end %>
    </div>
  </main>

  <%= render 'shared/footer' %>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const fileInput = document.getElementById('file-upload');
    const fileNameDisplay = document.getElementById('file-name-display');

    if (fileInput && fileNameDisplay) {
      fileInput.addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
          // Change the text to the file name and make it green
          fileNameDisplay.textContent = 'Selected: ' + file.name;
          fileNameDisplay.classList.remove('text-[#003e8d]');
          fileNameDisplay.classList.add('text-green-600', 'font-bold');
        } else {
          // Reset if they cancel
          fileNameDisplay.textContent = 'Upload a file';
          fileNameDisplay.classList.remove('text-green-600', 'font-bold');
          fileNameDisplay.classList.add('text-[#003e8d]');
        }
      });
    }
  });
</script>