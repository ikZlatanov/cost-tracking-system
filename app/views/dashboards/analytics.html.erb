<div class="min-h-screen flex flex-col bg-slate-50">
  <%= render 'shared/header' %>
  
  <main class="flex-grow p-4 md:p-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900">Global Financial Analytics</h1>
        <p class="text-slate-500">Comprehensive overview of company-wide spending.</p>
      </div>
      <%= link_to admin_dashboard_path, class: "text-sm font-medium text-[#003e8d] hover:underline" do %>
        &larr; Back to Project Dashboard
      <% end %>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 mb-8">
      <%= form_with url: admin_analytics_path, method: :get, class: "grid grid-cols-1 md:grid-cols-4 gap-4 items-end", data: { turbo: false } do |f| %>
        <div>
          <%= f.label :start_date, "From Date", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" %>
        </div>
        <div>
          <%= f.label :end_date, "To Date", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" %>
        </div>
        <div>
          <%= f.label :currency, "Currency", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.select :currency, ['USD', 'EUR', 'GBP', 'BGN'], { prompt: "All Currencies", selected: params[:currency] }, { class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" } %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "Update Analytics", class: "flex-grow bg-[#003e8d] text-white text-sm font-bold py-2.5 rounded-lg hover:bg-[#003e8d]/90 cursor-pointer" %>
          <%= link_to "Reset", admin_analytics_path, class: "bg-slate-100 text-slate-700 text-sm font-bold py-2.5 px-4 rounded-lg hover:bg-slate-200" %>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <% ['USD', 'EUR', 'GBP', 'BGN'].each do |curr| %>
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
          <p class="text-xs font-bold text-slate-500 uppercase tracking-widest"><%= curr %> Total</p>
          <p class="text-2xl font-black text-slate-900 mt-1">
            <%= number_to_currency(@totals_by_currency[curr] || 0, unit: curr + " ") %>
          </p>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
        <h3 class="text-lg font-bold text-slate-800 mb-4">Spending by Category</h3>
        <div class="relative flex-grow h-64 w-full">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>

      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
        <h3 class="text-lg font-bold text-slate-800 mb-4">Spending Status Distribution</h3>
        <div class="relative flex-grow h-64 w-full">
          <canvas id="statusChart"></canvas>
        </div>
      </div>

    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <h3 class="text-lg font-bold text-slate-800">Detailed Transaction Log</h3>
        <span class="text-sm text-slate-500"><%= @expenses.count %> transactions found</span>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Project</th>
              <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Vendor</th>
              <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Category</th>
              <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Date</th>
              <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase">Amount</th>
              <th class="px-6 py-3 text-right text-xs font-bold text-slate-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% @expenses.each do |expense| %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-sm font-medium text-slate-900"><%= expense.project.name %></td>
                <td class="px-6 py-4 text-sm text-slate-600"><%= expense.vendor_name %></td>
                <td class="px-6 py-4 text-sm text-slate-500"><%= expense.category.name %></td>
                <td class="px-6 py-4 text-sm text-slate-500"><%= expense.expense_date.strftime('%d %b %Y') %></td>
                <td class="px-6 py-4 text-sm font-bold text-slate-900"><%= expense.amount %> <%= expense.currency %></td>
                <td class="px-6 py-4 text-right">
                  <%= link_to 'Details', expense_path(expense), class: "text-[#003e8d] hover:underline text-sm font-bold" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%= render 'shared/footer' %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  // Category Pie Chart
  const ctxCat = document.getElementById('categoryChart').getContext('2d');
  new Chart(ctxCat, {
      type: 'pie',
      data: {
          labels: <%= raw @category_data.keys %>,
          datasets: [{
              data: <%= raw @category_data.values %>,
              backgroundColor: ['#003e8d', '#fbbf24', '#10b981', '#ef4444', '#8b5cf6']
          }]
      },
      options: { responsive: true, maintainAspectRatio: false }
  });

  // Status Chart
  const ctxStatus = document.getElementById('statusChart').getContext('2d');
  new Chart(ctxStatus, {
      type: 'doughnut',
      data: {
          labels: ['Approved', 'Pending', 'Rejected'],
          datasets: [{
              data: [
                <%= @expenses.where(status: 'Approved').count %>,
                <%= @expenses.where(status: 'Pending').count %>,
                <%= @expenses.where(status: 'Rejected').count %>
              ],
              backgroundColor: ['#10b981', '#fbbf24', '#ef4444']
          }]
      },
      options: { responsive: true, maintainAspectRatio: false }
  });
</script>