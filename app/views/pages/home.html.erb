<style>
  body { overflow: hidden; }
</style>

<div class="h-screen flex flex-col bg-slate-50">
  
  <nav class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <div class="flex-shrink-0 flex items-center">
          <%= image_tag "wollowLogo.png", class: "h-8 w-auto" %>
        </div>
        <div>
          <%= link_to "Sign In", login_path, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[#003e8d] hover:bg-[#003e8d]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003e8d] transition-colors" %>
        </div>
      </div>
    </div>
  </nav>

  <main class="flex-grow flex items-center justify-center">
    <div class="text-center px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto">
      <h1 class="text-4xl tracking-tight font-extrabold text-slate-900 sm:text-5xl md:text-6xl">
        Automated Cost <span class="text-[#003e8d]">Allocation Engine</span>
      </h1>
    </div>
  </main>

  <%= render 'shared/footer' %>

</div>