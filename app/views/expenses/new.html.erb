<div class="min-h-screen flex flex-col bg-slate-50 relative">
  <%= render 'shared/header' %>
  
  <% if flash[:notice] %>
    <div id="toast-notification" class="fixed top-20 right-4 sm:right-8 w-full max-w-sm p-4 bg-white rounded-lg shadow-2xl border-l-4 border-green-500 z-50 transition-opacity duration-300" role="alert">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-green-600 uppercase tracking-wider">Expense Logged</span>
            <button type="button" onclick="document.getElementById('toast-notification').remove()" class="text-slate-400 hover:bg-slate-100 hover:text-slate-900 rounded-lg p-1.5 inline-flex h-8 w-8 justify-center items-center transition-colors">
                <span class="sr-only">Close</span>
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </div>
        <div class="flex items-start">
            <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-green-500 bg-green-100 rounded-full mt-0.5">
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
                </svg>
            </div>
            <div class="ms-3 text-sm font-medium text-slate-700 whitespace-pre-wrap"><%= flash[:notice] %></div>
        </div>
    </div>

    <script>
      setTimeout(() => {
        const toast = document.getElementById('toast-notification');
        if(toast) { 
          toast.style.opacity = '0'; 
          setTimeout(() => toast.remove(), 300); 
        }
      }, 5000); // 5000ms = 5 seconds
    </script>
  <% end %>
  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full bg-white p-8 rounded-xl shadow-lg border border-slate-200">
      
      <div class="mb-8 border-b border-slate-200 pb-4">
        <h2 class="text-3xl font-extrabold text-slate-900">Log an Expense</h2>
        <p class="mt-2 text-sm text-slate-500">Submit a new project expense for approval.</p>
      </div>

      <%= form_with model: @expense, class: "space-y-6", data: { turbo: false } do |f| %>
        
        <% if @expense.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
            <h3 class="text-sm font-medium text-red-800"><%= pluralize(@expense.errors.count, "error") %> prohibited this expense from being saved:</h3>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% @expense.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
          
          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-900 mb-1">Project *</label>
            <%= f.collection_select :project_id, Project.all, :id, :name, { prompt: "Select a project" }, { class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3" } %>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-900 mb-1">Expense Category *</label>
            <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, { class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3" } %>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-1">Amount *</label>
            <%= f.number_field :amount, step: "0.01", class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3", placeholder: "0.00" %>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-1">Currency *</label>
            <%= f.select :currency, ['USD', 'EUR', 'GBP', 'BGN'], { prompt: "Select currency" }, { class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3" } %>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-1">Date of Expense *</label>
            <%= f.date_field :expense_date, class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3" %>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-900 mb-1">Vendor Name *</label>
            <%= f.text_field :vendor_name, class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3", placeholder: "e.g. Amazon Web Services" %>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-900 mb-1">Description (Optional)</label>
            <%= f.text_area :description, rows: 3, class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d] py-2.5 px-3", placeholder: "Briefly describe the business purpose..." %>
          </div>

        </div>

        <div class="pt-4 flex justify-end space-x-3 border-t border-slate-200 mt-6">
          <% cancel_path = case current_user.role
                           when 'admin' then admin_dashboard_path
                           when 'project_manager' then pm_dashboard_path
                           when 'developer' then developer_dashboard_path
                           else root_path
                           end %>

          <%= link_to "Cancel", cancel_path, class: "px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003e8d]" %>
          <%= f.submit "Log Expense", class: "px-4 py-2 text-sm font-medium text-white bg-[#003e8d] rounded-lg hover:bg-[#003e8d]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003e8d] cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </main>
  <%= render 'shared/footer' %>
</div>