<div class="min-h-screen flex flex-col bg-slate-50">
  <%= render 'shared/header' %>
  
  <main class="flex-grow p-4 md:p-8 max-w-7xl mx-auto w-full">
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4 border-b border-slate-300 pb-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900">Cost History Table</h1>
        <p class="text-slate-600 mt-1">Master ledger of all recorded infrastructure and operational expenses.</p>
      </div>
      <%= link_to "+ Log Manual Expense", new_expense_path, class: "px-4 py-2 bg-[#003e8d] text-white text-sm font-medium rounded-lg hover:bg-[#003e8d]/90 shadow-sm" %>
    </div>

    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 mb-8">
      <%= form_with url: expenses_path, method: :get, class: "grid grid-cols-1 md:grid-cols-5 gap-4 items-end", data: { turbo: false } do |f| %>
        
        <div>
          <%= f.label :start_date, "From Date", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" %>
        </div>
        
        <div>
          <%= f.label :end_date, "To Date", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" %>
        </div>

        <div>
          <%= f.label :project_id, "Project", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.collection_select :project_id, Project.all, :id, :name, { prompt: "All Projects", selected: params[:project_id] }, { class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" } %>
        </div>

        <div>
          <%= f.label :vendor_name, "Vendor Search", class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
          <%= f.text_field :vendor_name, value: params[:vendor_name], placeholder: "e.g. Amazon", class: "w-full text-sm border-slate-300 rounded-lg focus:ring-[#003e8d] focus:border-[#003e8d]" %>
        </div>

        <div class="flex gap-2">
          <%= f.submit "Filter", class: "flex-grow bg-[#003e8d] text-white text-sm font-bold py-2.5 rounded-lg hover:bg-[#003e8d]/90 cursor-pointer" %>
          <% if params[:start_date].present? || params[:project_id].present? || params[:vendor_name].present? %>
            <%= link_to "Clear", expenses_path, class: "bg-slate-100 text-slate-700 text-sm font-bold py-2.5 px-4 rounded-lg hover:bg-slate-200 text-center" %>
          <% end %>
        </div>

      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
        <span class="text-sm font-medium text-slate-700">Displaying <%= @expenses.count %> results</span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-white">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Date</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Project</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Vendor / Category</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Amount</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Status</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-bold text-slate-600 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if @expenses.any? %>
              <% @expenses.each do |expense| %>
                <tr class="hover:bg-slate-50 transition-colors">
                  
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                    <%= expense.expense_date&.strftime('%b %d, %Y') || 'N/A' %>
                  </td>
                  
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-bold text-slate-900"><%= expense.project&.name || 'Unassigned' %></div>
                    <div class="text-xs text-slate-500"><%= expense.project&.status || 'Unknown' %></div>
                  </td>
                  
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-slate-900"><%= expense.vendor_name %></div>
                    <div class="text-xs text-slate-500"><%= expense.category&.name || 'Uncategorized' %></div>
                  </td>
                  
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-900">
                    <%= expense.amount %> <span class="text-xs text-slate-600 font-normal"><%= expense.currency %></span>
                  </td>
                  
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                      <%= case expense.status
                          when 'Approved' then 'bg-green-100 text-green-800'
                          when 'Pending' then 'bg-amber-100 text-amber-800'
                          when 'Rejected' then 'bg-red-100 text-red-800'
                          else 'bg-slate-100 text-slate-800'
                          end %>">
                      <%= expense.status || 'Draft' %>
                    </span>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
                    <%= link_to 'View', expense_path(expense), class: "text-[#003e8d] hover:underline" %>
                    <%= link_to 'Edit', edit_expense_path(expense), class: "text-amber-700 hover:underline" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-slate-600">
                  <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto text-slate-400 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                  <p class="text-lg font-medium">No expenses found.</p>
                  <p class="text-sm">Try adjusting your filters to see more results.</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <div class="px-6 py-4 border-t border-slate-200 bg-white flex items-center justify-center">
        <%= paginate @expenses %>
      </div>
    </div>
  </main>
  
  <%= render 'shared/footer' %>
</div>