<div class="min-h-screen flex flex-col bg-slate-50">
  <%= render 'shared/header' %>
  
  <main class="flex-grow p-4 md:p-8 flex items-center justify-center">
    <div class="max-w-2xl w-full bg-white shadow-lg rounded-xl overflow-hidden border border-slate-200">
      
      <div class="px-6 py-5 bg-slate-800 border-b border-slate-200">
        <h3 class="text-xl font-bold text-white">Edit Expense #<%= @expense.id %></h3>
      </div>

      <div class="p-6 md:p-8">
        <%= form_with(model: @expense, local: true, class: "space-y-6") do |form| %>
          
          <% if @expense.errors.any? %>
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
              <h2 class="text-red-800 text-sm font-bold"><%= pluralize(@expense.errors.count, "error") %> prohibited this expense from being saved:</h2>
              <ul class="list-disc pl-5 mt-2 text-sm text-red-700">
                <% @expense.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div>
              <%= form.label :project_id, class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Select a Project" }, { class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" } %>
            </div>

            <div>
              <%= form.label :category_id, class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Select a Category" }, { class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" } %>
            </div>

            <div>
              <%= form.label :amount, class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.number_field :amount, step: "0.01", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" %>
            </div>

            <div>
              <%= form.label :currency, class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.select :currency, ['USD', 'EUR', 'GBP', 'BGN'], {}, { class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" } %>
            </div>

            <div>
              <%= form.label :expense_date, "Date of Expense", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.date_field :expense_date, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" %>
            </div>

            <div>
              <%= form.label :vendor_name, "Vendor", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.text_field :vendor_name, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= form.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm" %>
            </div>

            <div class="md:col-span-2 bg-slate-100 p-4 rounded-md border border-slate-200">
              <%= form.label :status, "Approval Status", class: "block text-sm font-bold text-slate-800 mb-2" %>
              <div class="flex items-center gap-4">
                <%= form.select :status, ['Pending', 'Approved', 'Rejected'], { prompt: "Select Status" }, { class: "block w-1/2 rounded-md border-slate-300 shadow-sm focus:border-[#003e8d] focus:ring-[#003e8d] sm:text-sm font-medium" } %>
              </div>
            </div>

          </div>

          <div class="pt-5 border-t border-slate-200 flex justify-end gap-3 mt-6">
            <%= link_to 'Cancel', expense_path(@expense), class: "px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 transition-colors" %>
            <%= form.submit "Update Expense", class: "px-6 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#003e8d] hover:bg-[#003e8d]/90 cursor-pointer transition-colors" %>
          </div>

        <% end %>
      </div>
    </div>
  </main>
  <%= render 'shared/footer' %>
</div>