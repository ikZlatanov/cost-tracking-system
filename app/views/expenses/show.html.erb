<div class="min-h-screen flex flex-col bg-slate-50">
  <%= render 'shared/header' %>
  
  <main class="flex-grow p-4 md:p-8 flex items-center justify-center">
    <div class="max-w-3xl w-full bg-white shadow-lg rounded-xl overflow-hidden border border-slate-200">
      
      <div class="px-6 py-5 bg-slate-800 border-b border-slate-200 flex justify-between items-center">
        <h3 class="text-xl font-bold text-white">
          Expense Details #<%= @expense.id %>
        </h3>
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider
          <%= case @expense.status
              when 'Approved' then 'bg-green-500 text-white'
              when 'Pending' then 'bg-amber-500 text-white'
              when 'Rejected' then 'bg-red-500 text-white'
              else 'bg-slate-500 text-white'
              end %>">
          <%= @expense.status || 'Draft' %>
        </span>
      </div>

      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
          
          <div>
            <label class="block text-sm font-medium text-slate-500">Project</label>
            <p class="mt-1 text-lg font-semibold text-slate-900"><%= @expense.project&.name || 'N/A' %></p>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-500">Category</label>
            <p class="mt-1 text-lg font-semibold text-slate-900"><%= @expense.category&.name || 'N/A' %></p>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-500">Vendor</label>
            <p class="mt-1 text-lg text-slate-900"><%= @expense.vendor_name.presence || 'N/A' %></p>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-500">Date</label>
            <p class="mt-1 text-lg text-slate-900"><%= @expense.expense_date&.strftime('%B %d, %Y') || 'N/A' %></p>
          </div>

          <div class="md:col-span-2 bg-slate-50 p-4 rounded-lg border border-slate-100">
            <label class="block text-sm font-medium text-slate-500">Amount</label>
            <p class="mt-1 text-3xl font-bold text-slate-900">
              <%= @expense.amount %> <span class="text-lg text-slate-500 font-normal"><%= @expense.currency %></span>
            </p>
          </div>

          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-slate-500">Description</label>
            <p class="mt-1 text-base text-slate-700 whitespace-pre-wrap"><%= @expense.description.presence || 'No description provided.' %></p>
          </div>

          <div class="md:col-span-2 flex justify-between items-center text-sm text-slate-500 border-t pt-4 mt-2">
            <span>Submitted by: <strong><%= @expense.creator&.first_name || 'Unknown' %></strong></span>
            <span>Created on: <%= @expense.created_at.strftime('%b %d, %Y %H:%M') %></span>
          </div>

        </div>
      </div>

      <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
        <%= link_to 'Back to Dashboard', admin_dashboard_path, class: "px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 transition-colors" %>
        <%= link_to 'Edit Expense', edit_expense_path(@expense), class: "px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-amber-600 hover:bg-amber-700 transition-colors" %>
      </div>

    </div>
  </main>
  
  <%= render 'shared/footer' %>
</div>